# Dev: nisbiy manzil + Vite proksisi (cookie uchun eng ishonchli yo'l)
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=https://api.alishaxkids.uz

# Prod: sayt va API bitta domen ostida bo'lsa to'liq manzil ham bo'ladi
# VITE_API_BASE_URL=https://api.alishaxkids.uz/api/v1

# Ommaviy sayt qaysi bog'cha (tenant) sahifasini o'qiydi.
#
# MUHIM: bu qiymat bo'sh bo'lsa, frontend `/public/landing` ga murojaat qiladi
# va u faqat backendda LANDING_DEFAULT_TENANT_CODE o'rnatilgan bo'lsagina
# ishlaydi. Ikkalasi ham bo'sh bo'lsa ommaviy so'rov 404 qaytaradi va sayt
# jimgina statik matnga qaytadi — ya'ni adminkada chop etilgan kontent hech
# qachon ko'rinmaydi.
#
# Kodni bilmasangiz: tizimga kiring va «Sayt» bo'limidagi «Ommaviy sahifa
# holati» panelidagi tekshiruvni ishga tushiring — u qaysi manzil ishlayotganini
# va nima qaytayotganini ko'rsatadi.
VITE_LANDING_TENANT_CODE=
